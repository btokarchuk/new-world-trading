# Data & state — never committed
data/
# secrets/* (not secrets/) so the negation below can re-include templates;
# git never descends into a directory ignored as a whole
secrets/*
*.env
*.db
*.db-wal
*.db-shm
# ...except committed secret templates (placeholders only, never real values)
!secrets/*.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
dist/
*.egg-info/

# macOS / editors
.DS_Store
.idea/
.vscode/

# Xcode / iOS (populated in Phase 5)
ios/**/xcuserdata/
ios/**/DerivedData/
# watchdog keys follow the same rule as every other secret
!secrets/watchdog-*.env.example
