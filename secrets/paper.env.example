# Template for secrets/paper.env — copy, fill in, and lock down:
#   cp secrets/paper.env.example secrets/paper.env
#   chmod 700 secrets && chmod 600 secrets/paper.env
#
# Paper keys come from the Alpaca dashboard (paper account section).
# NEVER put live keys in this file — live keys belong in secrets/live.env,
# which must not exist until the arming ceremony creates it.
#
# Real environment variables always override values loaded from this file.

ALPACA_PAPER_KEY_ID=PK_your_paper_key_id_here
ALPACA_PAPER_SECRET=your_paper_secret_here
