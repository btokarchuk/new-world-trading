# Copy to secrets/watchdog-paper.env and fill in. Placeholders only here —
# secrets/*.example is the ONLY thing under secrets/ that git tracks.
#
# These MUST be a SEPARATE Alpaca key pair from the engine's (Alpaca dashboard
# -> paper account -> generate a second API key). Sharing one pair means a
# single revoked, rotated, or rate-limited credential blinds the supervisor at
# the same instant it disables the thing being supervised — and the watchdog's
# key is the one that still has to work when everything else has failed.
#
# Real environment variables win over this file, so do not export the engine's
# keys into the watchdog's shell.

ALPACA_PAPER_KEY_ID=PK_replace_me_watchdog
ALPACA_PAPER_SECRET=replace_me_watchdog_secret
